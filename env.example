# Copier vers .env.local et renseigner (ne pas committer .env.local)

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kopio.eu

# Lien Calendly (popup rendez-vous)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/karelle-dev/30min

# Optionnel : Google Analytics (laisser vide = pas de GA, conforme mentions actuelles)
# NEXT_PUBLIC_GA_ID=

# Sem.1 — logs bots dans Vercel Logs (0 €). Mettre 0 pour désactiver.
# BOT_CRAWL_LOG=0

# Leads quiz → Gmail via Web3Forms (gratuit, côté navigateur uniquement).
# Créer une clé sur https://web3forms.com — NEXT_PUBLIC_ car le plan gratuit
# refuse les appels serveur (403). Même clé à mettre sur Vercel.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Sem.4 — IndexNow (Bing, gratuit). La clé doit matcher public/{KEY}.txt
# INDEXNOW_KEY=ef4ae294-b4cb-4cc0-a37d-a7d2241cfc18
# Secret pour POST /api/indexnow (Authorization: Bearer …)
# INDEXNOW_SECRET=
