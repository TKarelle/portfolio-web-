# Copier vers .env.local et renseigner (ne pas committer .env.local)

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kopio.eu

# Lien Calendly (popup rendez-vous)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/karelle-dev/30min

# Optionnel : Google Analytics (laisser vide = pas de GA, conforme mentions actuelles)
# NEXT_PUBLIC_GA_ID=

# Sem.1 — logs bots dans Vercel Logs (0 €). Mettre 0 pour désactiver.
# BOT_CRAWL_LOG=0

# Leads quiz → email (défaut = CONTACT_EMAIL / karelle.dev@gmail.com via FormSubmit, 0 €)
# QUIZ_LEADS_EMAIL=karelle.dev@gmail.com

# Optionnel — webhook Discord en plus de l’email
# QUIZ_LEADS_WEBHOOK_URL=
